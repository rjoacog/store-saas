# Copiar a .env y ajustar valores.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
PORT=3000
JWT_SECRET="change-me-in-production-min-32-chars-please"
# Orígenes CORS separados por coma. Si omites CORS_ORIGINS y FRONTEND_URL, main.ts aplica orígenes por defecto (revisa main.ts).
CORS_ORIGINS="http://localhost:5173,https://tu-dominio-frontend.example"
# Opcional: un solo origen (equivale a una entrada en CORS_ORIGINS)
# FRONTEND_URL=
